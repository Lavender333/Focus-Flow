{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && cp dist/app.html dist/index.html && cp dist/index.html index.html && mkdir -p assets && cp -R dist/assets/. assets/ && cp dist/manifest.webmanifest dist/sw.js dist/*.png dist/favicon.ico .",
    "build:ios": "VITE_BASE_PATH=./ vite build && cp dist/app.html dist/index.html",
    "sync:ios": "npm run build:ios && npx cap sync ios",
    "open:ios": "npm run sync:ios && npx cap open ios",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "audit:frequencies": "node scripts/audit_frequencies.mjs"
  },
  "dependencies": {
    "@capacitor/core": "^8.4.1",
    "@revenuecat/purchases-capacitor": "^13.2.2",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.3",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "tailwind-merge": "^3.5.0",
    "vite": "^6.2.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.4.1",
    "@capacitor/ios": "^8.4.1",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}
